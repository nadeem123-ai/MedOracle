# MedOracle  Production Configuration
# Copy to .env and fill in your values

# API Keys
GROQ_API_KEY=your-groq-api-key-here

# Database
DATABASE_URL=postgresql://MedOracle:MedOracle123@postgres:5432/MedOracle
DB_PASSWORD=MedOracle123

# Security
SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=production
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO
LOG_FILE=MedOracle.log

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_ALERTS=true
ENABLE_AB_TESTING=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
